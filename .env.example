# Copy this file to .env. Keep keys here, never in the browser.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Downloads a free local embedding model on first setup (~90 MB).
ENABLE_SEMANTIC_CACHE=true
NEWS_REFRESH_MINUTES=30
CACHE_MINUTES=20
GROQ_DAILY_TOKEN_BUDGET=120000

# Default number of stories per briefing (1-100); the UI can override it.
NEWS_ARTICLE_COUNT=50

# Optional PostgreSQL storage for local testing (migrate first). Leave empty for SQLite.
DATABASE_URL=
MAX_STORED_ARTICLES=5000
# Production hosting settings are listed in DEPLOYMENT.md.
